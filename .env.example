# Nina Environment Configuration Template

# Core Environment Settings
NINA_ENV=development
NINA_DEBUG=true
NINA_LOG_LEVEL=INFO
NINA_DEVICE=auto  # Options: auto, cuda, cpu, mps

# Storage & Model Paths
NINA_MODEL_DIR=./models
NINA_HUGGINGFACE_CACHE_DIR=./huggingface_cache

# Audio Input Settings
NINA_AUDIO_SAMPLE_RATE=16000
NINA_AUDIO_CHANNELS=1
NINA_AUDIO_RECORD_SECONDS=5
NINA_AUDIO_MAX_DURATION_SECONDS=30
NINA_AUDIO_MIN_RMS_THRESHOLD=0.001
NINA_AUDIO_DEVICE_INDEX=0

# Speech-to-Text (ASR) Settings
NINA_STT_ENGINE=faster-whisper  # Options: faster-whisper, whisper, stub
NINA_STT_MODEL_NAME=faster-whisper
NINA_STT_MODEL_SIZE=base.en  # Options: tiny.en, base.en, small.en, medium.en
NINA_STT_COMPUTE_TYPE=float16  # Options: float16, int8_float16, int8, float32

# Emotion Classifier Settings
NINA_EMOTION_ENGINE=roberta  # Options: roberta, stub
NINA_EMOTION_MODEL_NAME=bhadresh-ps/roberta-base-emotion
NINA_EMOTION_MAX_LENGTH=128
NINA_EMOTION_BATCH_SIZE=1

# Thresholds
NINA_CONFIDENCE_THRESHOLD=0.5
NINA_INTENSITY_LOW_THRESHOLD=0.55
NINA_INTENSITY_HIGH_THRESHOLD=0.80

# API Settings
NINA_API_HOST=127.0.0.1
NINA_API_PORT=8000
